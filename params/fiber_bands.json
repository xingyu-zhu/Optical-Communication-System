{
  "_note": "光纤/波段/放大器参数库（Python 与 MATLAB 共用）。以 '_' 开头的键为说明，程序忽略。修改此文件即可改变所有仿真默认参数。",
  "_units": "波长 nm；衰减 dB/km；色散斜率 ps/(nm^2 km)；有效面积 um^2；n2 m^2/W；PMD ps/sqrt(km)；NF dB；Raman 时间常数 fs",
  "_dispersion_model": "D(λ) = S0/4·(λ - λ0^4/λ^3) [ps/(nm km)]（ITU-T G.652 三项 Sellmeier 拟合），S(λ) = S0/4·(1 + 3λ0^4/λ^4)",
  "_aeff_model": "Aeff(λ) = Aeff_1550·(λ/1550)^aeff_exp；γ = 2π·n2/(λ·Aeff)",
  "_alpha_model": "α(λ) = 波段典型衰减 alpha_db_km + 光纤类型修正 alpha_offset_db_km",

  "bands": {
    "O": {"range_nm": [1260, 1360], "center_nm": 1310, "alpha_db_km": 0.33, "amplifier": "PDFA / SOA", "nf_db": 6.5, "_note": "零色散附近，FWM 强；IM-DD 数据中心常用"},
    "E": {"range_nm": [1360, 1460], "center_nm": 1410, "alpha_db_km": 0.30, "amplifier": "BDFA (Bi-doped)", "nf_db": 6.0, "_note": "需低水峰光纤 (G.652.D)"},
    "S": {"range_nm": [1460, 1530], "center_nm": 1495, "alpha_db_km": 0.23, "amplifier": "TDFA (Tm-doped)", "nf_db": 6.0, "_note": "SRS 中向 C/L 转移功率"},
    "C": {"range_nm": [1530, 1565], "center_nm": 1550, "alpha_db_km": 0.20, "amplifier": "C-EDFA", "nf_db": 5.0, "_note": "最低损耗窗口，主流相干传输"},
    "L": {"range_nm": [1565, 1625], "center_nm": 1590, "alpha_db_km": 0.21, "amplifier": "L-EDFA", "nf_db": 5.5, "_note": "SRS 受益波段"},
    "U": {"range_nm": [1625, 1675], "center_nm": 1650, "alpha_db_km": 0.25, "amplifier": "Raman / U-band DFA", "nf_db": 6.5, "_note": "弯曲损耗上升，常用于监控"}
  },

  "fibers": {
    "SSMF":  {"itu": "G.652.D", "lambda0_nm": 1312, "S0": 0.090, "aeff_um2": 80,  "aeff_exp": 1.0, "n2": 2.6e-20, "pmd": 0.05, "alpha_offset_db_km": 0.00, "_note": "标准单模光纤，D(1550) ≈ 17"},
    "ULL":   {"itu": "G.654.E", "lambda0_nm": 1300, "S0": 0.107, "aeff_um2": 125, "aeff_exp": 1.0, "n2": 2.2e-20, "pmd": 0.04, "alpha_offset_db_km": -0.04, "_note": "超低损耗大有效面积纯硅芯光纤，D(1550) ≈ 21"},
    "NZDSF": {"itu": "G.655",   "lambda0_nm": 1450, "S0": 0.060, "aeff_um2": 72,  "aeff_exp": 1.0, "n2": 2.6e-20, "pmd": 0.04, "alpha_offset_db_km": 0.01, "_note": "非零色散位移光纤，D(1550) ≈ 5"},
    "DSF":   {"itu": "G.653",   "lambda0_nm": 1550, "S0": 0.085, "aeff_um2": 50,  "aeff_exp": 1.0, "n2": 2.6e-20, "pmd": 0.05, "alpha_offset_db_km": 0.02, "_note": "色散位移光纤，C 波段 D ≈ 0，WDM 下 FWM 严重"}
  },

  "raman": {"fR": 0.18, "tau1_fs": 12.2, "tau2_fs": 32.0, "_note": "石英 Raman 响应 h_R(t) = (τ1²+τ2²)/(τ1τ2²)·exp(-t/τ2)·sin(t/τ1)，峰值增益频移约 13.2 THz"},

  "wdm": {"spacing_ghz": 50, "_note": "默认 WDM 栅格（ITU-T G.694.1 灵活栅格可设 37.5/50/75/100 GHz）"}
}
